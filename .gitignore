# Binary deps (qpdf.exe + its runtime DLLs) are bundled in bin/ so the
# standalone PasswordProtect tool works out of the box. Pinned in bin/HASHES.txt.

# Local build / test artefacts
*.tmp
*.bak
tests/fixtures/out/
*.escrow.json

# Loud-failure logs written next to the launcher at runtime
PasswordProtect-error.log

# PowerShell module caches
*.psd1.bak

# .NET build output for the launcher exe. Scoped to launcher/ so the committed
# top-level bin/ with qpdf.exe is never ignored.
launcher/**/bin/
launcher/**/obj/
*.user

# Windows 11 shell-extension build output
shellext/out/
